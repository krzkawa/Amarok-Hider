<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calculator_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/calculator_tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minWidth="1dp"
                android:singleLine="true"
                android:text="0"
                android:textColor="@color/calculator_expression_text"
                android:textSize="44sp" />

        </HorizontalScrollView>

        <TextView
            android:id="@+id/calculator_tv_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="@color/calculator_preview_text"
            android:textSize="24sp" />

    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.45"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        android:columnCount="4"
        android:rowCount="5">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_clear"
            style="@style/Widget.Calculator.Key.Function"
            android:text="C"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_row="0"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_parenthesis"
            style="@style/Widget.Calculator.Key.Function"
            android:text="( )"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_row="0"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_backspace"
            style="@style/Widget.Calculator.Key.Function"
            android:text="⌫"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_row="0"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_divide"
            style="@style/Widget.Calculator.Key.Operator"
            android:text="÷"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_row="0"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_7"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="7"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_row="1"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_8"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="8"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_row="1"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_9"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="9"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_row="1"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_multiply"
            style="@style/Widget.Calculator.Key.Operator"
            android:text="×"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_row="1"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_4"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="4"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_row="2"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_5"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="5"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_row="2"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_6"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="6"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_row="2"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_subtract"
            style="@style/Widget.Calculator.Key.Operator"
            android:text="−"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_row="2"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_1"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_row="3"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_2"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="2"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_row="3"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_3"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="3"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_row="3"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_add"
            style="@style/Widget.Calculator.Key.Operator"
            android:text="+"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_row="3"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_sign"
            style="@style/Widget.Calculator.Key.Function"
            android:text="±"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_row="4"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_0"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_row="4"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_decimal"
            style="@style/Widget.Calculator.Key.Digit"
            android:text="."
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_row="4"
            android:layout_rowWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculator_bt_equals"
            style="@style/Widget.Calculator.Key.Equals"
            android:text="="
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_row="4"
            android:layout_rowWeight="1" />

    </GridLayout>

</LinearLayout>
