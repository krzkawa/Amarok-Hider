<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Amarok" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="preferenceTheme">@style/Theme.Amarok.Preference</item>
    </style>

    <style name="Theme.Amarok.Transparent" parent="Theme.Amarok">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.Calculator" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/calendar_bg_light</item>
        <item name="android:navigationBarColor">@color/calendar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.Amarok.Preference" parent="@style/PreferenceThemeOverlay.Rikka.Material3">
        <item name="android:tint">?attr/colorOnBackground</item>
    </style>


    <style name="Theme.CalculatorDisguise" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/calculator_bg</item>
        <item name="android:navigationBarColor">@color/calculator_bg</item>
        <item name="android:windowBackground">@color/calculator_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Widget.Calculator.Key" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.Calculator.Key.Digit">
        <item name="backgroundTint">@color/calculator_key_digit_bg</item>
        <item name="android:textColor">@color/calculator_key_digit_text</item>
    </style>

    <style name="Widget.Calculator.Key.Function">
        <item name="backgroundTint">@color/calculator_key_function_bg</item>
        <item name="android:textColor">@color/calculator_key_function_text</item>
    </style>

    <style name="Widget.Calculator.Key.Operator">
        <item name="backgroundTint">@color/calculator_key_operator_bg</item>
        <item name="android:textColor">@color/calculator_key_operator_text</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="Widget.Calculator.Key.Equals">
        <item name="backgroundTint">@color/calculator_key_equals_bg</item>
        <item name="android:textColor">@color/calculator_key_equals_text</item>
        <item name="android:textSize">26sp</item>
    </style>

</resources>